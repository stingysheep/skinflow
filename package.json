{
  "name": "skinflow-workspace",
  "version": "0.1.2",
  "private": true,
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @skinflow/web",
    "build": "npm run build --workspace @skinflow/web",
    "test": "npm run test --workspace @skinflow/web",
    "typecheck": "npm run typecheck --workspace @skinflow/web",
    "lint": "npm run lint --workspace @skinflow/web"
  }
}
